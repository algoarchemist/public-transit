{
  "name": "@setutrack/stream-processor",
  "version": "0.1.0",
  "private": true,
  "description": "GPS ping ingestion, map-matching, ETA scoring, and WebSocket fan-out for SetuTrack",
  "scripts": {
    "dev:consumer": "tsx watch src/consumer.ts",
    "dev:gateway": "tsx watch src/gateway.ts",
    "build": "tsc -p tsconfig.json",
    "start:consumer": "node dist/consumer.js",
    "start:gateway": "node dist/gateway.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "mqtt": "^5.10.3",
    "pg": "^8.13.1",
    "protobufjs": "^7.4.0",
    "socket.io": "^4.8.1",
    "@socket.io/redis-adapter": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
