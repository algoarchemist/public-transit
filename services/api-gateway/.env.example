PORT=3000
DATABASE_URL=postgres://setutrack:setutrack@localhost:5432/setutrack
# Which geo-ingest snapshot (data/snapshots/<label>/) the /routes endpoints serve,
# and the `cities.name` that POST /trips resolves route ids against.
SNAPSHOT_LABEL=mohali-tricity
# Where POST /trips and PATCH /trips/:id/end publish `bus/{busId}/status`
# (docs §7.2) for the stream-processor to pick up — same broker the driver app pings.
MQTT_BROKER_URL=mqtt://localhost:1883
