# Node
node_modules/
dist/
.env
!.env.example

# npm
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# ML artifacts (trained models are not checked in; export step produces these)
services/ml-service/artifacts/*.onnx

# Raw Overpass/OSRM/Google API responses — regenerable by re-running geo-ingest, and
# large. The derived snapshots in data/snapshots/ ARE committed on purpose, so a demo
# never depends on a live network (docs/IMPLEMENTATION_ARCHITECTURE.md §4.2).
data/cache/*
!data/cache/.gitkeep

# Simulator training-corpus output — synthetic, regenerable by re-running
# services/simulator, and large at real scale (90 days x 100 routes). Unlike
# data/snapshots/ (real geometry, worth committing), there's nothing here that
# can't be regenerated on demand.
data/backfill/

# Flutter / Dart (android/ios/web are generated by `flutter create .` and then
# committed as usual — only build output and tool caches are ignored)
apps/**/.dart_tool/
apps/**/build/
apps/**/.flutter-plugin-dependencies
apps/**/*.iml
apps/**/ios/Pods/
apps/**/ios/.symlinks/
apps/**/ios/Flutter/Flutter.framework
apps/**/android/.gradle/
apps/**/android/local.properties

# Claude Code local settings (per-user, not shared)
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker volumes are managed by compose, nothing to ignore here
